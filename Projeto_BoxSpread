    quit()

# Função para enviar ordem de compra
def send_buy_order(symbol, volume):
    request = {
        "action": mt5.TRADE_ACTION_DEAL,
        "symbol": symbol,
        "volume": volume,
        "type": mt5.ORDER_TYPE_BUY,
        "price": mt5.symbol_info_tick(symbol).ask,
        "sl": 0,  # Definir stop loss, se necessário
        "tp": 0,  # Definir take profit, se necessário
        "magic": 234000,  # Identificador único para a ordem
        "comment": "Box Spread Buy"
    }
    result = mt5.order_send(request)
    return result

# Função para enviar ordem de venda
def send_sell_order(symbol, volume):
    request = {
        "action": mt5.TRADE_ACTION_DEAL,
        "symbol": symbol,
        "volume": volume,
        "type": mt5.ORDER_TYPE_SELL,
        "price": mt5.symbol_info_tick(symbol).bid,
        "sl": 0,  # Definir stop loss, se necessário
        "tp": 0,  # Definir take profit, se necessário
        "magic": 234001,  # Identificador único para a ordem
        "comment": "Box Spread Sell"
    }
    result = mt5.order_send(request)
    return result

# Enviar ordens para as opções selecionadas
for index, row in best_call_options.iterrows():
    send_buy_order(row['ativo'], 1)  # Compra de uma unidade da opção de compra

for index, row in best_put_options.iterrows():
    send_sell_order(row['ativo'], 1)  # Venda de uma unidade da opção de venda

# Finalizar conexão com MetaTrader 5
mt5.shutdown()

